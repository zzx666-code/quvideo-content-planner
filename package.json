{
  "name": "quvideo-content-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A pi-based content activity planning agent for QuVideo assessment question 2",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/cli.ts",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "evaluate": "node --env-file-if-exists=.env scripts/evaluate.ts",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.ts",
    "format": "prettier --write src scripts tests",
    "format:check": "prettier --check src scripts tests"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.9.3",
    "prettier": "3.6.2"
  }
}
